# Copy to bash/models.env and point the two variables at your checkpoints.
#
# Shared training, calibration, strategy, and evaluation entries read these
# when ACTOR_MODEL_PATH / REWARD_MODEL_PATH are not already exported.
# SR-OPD (run_sr_opd_*.sh) and Frontier-TLR entries instead take explicit
# STUDENT_MODEL_PATH / TEACHER_MODEL_PATH, or MODELS_DIR for the Qwen pair.
#
# ACTOR_MODEL_PATH  = the Student (the model being trained)
# REWARD_MODEL_PATH = the Teacher (frozen; scores the sampled tokens)

ACTOR_MODEL_PATH=/path/to/Qwen3-1.7B
REWARD_MODEL_PATH=/path/to/Qwen3-4B
